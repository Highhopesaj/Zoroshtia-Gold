:root{font-family:Tahoma,Arial,sans-serif;color:#eef4ff;background:#050b14;font-synthesis:none}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 80% -10%,#183455 0,#08111f 35%,#050b14 75%);min-height:100vh}button{font:inherit;color:inherit;background:#0d1929;border:1px solid #263b54;border-radius:10px;padding:10px 14px;cursor:pointer}button:hover{border-color:#d8ae52}.app{min-height:100vh}header{height:72px;position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:18px;padding:0 22px;background:rgba(5,11,20,.92);backdrop-filter:blur(14px);border-bottom:1px solid #1d3047}.brand{display:flex;align-items:center;gap:10px;cursor:pointer;min-width:230px}.brand img{width:42px;height:42px}.brand b{display:block;letter-spacing:1px}.brand small{display:block;color:#d8ae52;font-size:11px;margin-top:3px}.ticker{flex:1;color:#9eacc0;font-size:12px}.ticker strong{color:#f6d982;margin:0 5px}.ticker em{color:#48d597;font-style:normal}.live{display:inline-block;width:7px;height:7px;border-radius:50%;background:#48d597;margin-left:5px}.actions{display:flex;gap:7px}.actions button{padding:8px 10px}aside{position:fixed;right:0;top:72px;bottom:0;width:220px;padding:16px 12px;background:#07111e;border-left:1px solid #1d3047;overflow:auto;z-index:15}aside button{display:flex;align-items:center;gap:10px;width:100%;margin:4px 0;text-align:right;background:transparent;border-color:transparent;color:#9eacc0}aside button.sel,aside button:hover{background:#17263a;color:#f6d982;border-color:#263b54}.side-title{font-size:10px;color:#65758b;margin:13px 8px 7px;letter-spacing:1px}main{margin-right:220px;padding:28px 32px 90px;max-width:1500px}.page-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}.eyebrow,.pill{font-size:10px;letter-spacing:1.4px;color:#d8ae52}.page-head h1{margin:6px 0 0;font-size:28px}.status{display:flex;align-items:center;gap:6px;color:#48d597;font-size:12px}.hero{display:grid;grid-template-columns:1.6fr .7fr;gap:18px;background:linear-gradient(135deg,#101f33,#0a1320);border:1px solid #2a405a;border-radius:22px;padding:32px;box-shadow:0 25px 70px #0005}.hero h2{font-size:32px;line-height:1.45;max-width:760px;margin:14px 0}.hero p{color:#aebbd0;max-width:700px;line-height:1.9}.hero-buttons{display:flex;gap:10px;margin-top:24px}.primary{background:linear-gradient(135deg,#d8ae52,#9e7628);color:#07101b;border:0;font-weight:700}.hero-card{border:1px solid #3b4e65;border-radius:18px;padding:24px;background:#08111d;display:flex;flex-direction:column;justify-content:center}.hero-card span,.metric span{color:#8d9db3;font-size:12px}.hero-card strong{font-size:35px;margin:10px 0}.hero-card em,.up{color:#48d597;font-style:normal}.spark{color:#d8ae52;font-size:25px;margin-top:20px;letter-spacing:4px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:18px 0}.metric{padding:20px;background:#0a1524;border:1px solid #1d3047;border-radius:16px}.metric strong{display:block;font-size:22px;margin:9px 0}.metric em{display:flex;align-items:center;gap:4px;font-size:11px;color:#8d9db3}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.card{padding:22px;background:#0a1524;border:1px solid #1d3047;border-radius:16px}.card-title{display:flex;align-items:center;gap:10px;color:#f6d982}.card-title svg{width:20px}.card p,.module p{color:#9eacc0;line-height:1.8;font-size:13px}.module{max-width:950px;background:#0a1524;border:1px solid #20344c;border-radius:22px;padding:42px;text-align:right}.module-icon{width:54px;height:54px;display:grid;place-items:center;background:#17263a;border-radius:15px;color:#d8ae52}.module h2{font-size:28px;margin:20px 0 8px}.notice{display:flex;gap:12px;align-items:flex-start;padding:18px;background:#0d1929;border:1px solid #29415d;border-radius:14px;margin:25px 0}.notice svg{color:#48d597;flex:none}.notice span{display:block;color:#9eacc0;font-size:12px;margin-top:6px}.actions-row{display:flex;gap:10px}.bottom{display:none}.menu{display:none}
@media(max-width:900px){header{padding:0 12px}.menu{display:block;padding:8px}.brand{min-width:0}.ticker{display:none}aside{transform:translateX(100%);transition:.2s}.open{transform:translateX(0)}main{margin-right:0;padding:20px 14px 90px}.hero{grid-template-columns:1fr;padding:22px}.hero h2{font-size:25px}.grid{grid-template-columns:repeat(2,1fr)}.cards{grid-template-columns:1fr}.bottom{position:fixed;display:grid;grid-template-columns:repeat(5,1fr);bottom:0;left:0;right:0;z-index:30;background:#07111e;border-top:1px solid #1d3047;padding:5px}.bottom button{border:0;background:transparent;padding:7px 2px;color:#8797ad;font-size:9px;display:flex;flex-direction:column;align-items:center;gap:3px}.bottom button.sel{color:#f6d982}.page-head h1{font-size:22px}}
